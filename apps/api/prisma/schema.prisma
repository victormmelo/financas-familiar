generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MEMBER
}

enum AccountType {
  CHECKING
  SAVINGS
  JOINT
  INVESTMENT
  CASH
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  DRAFT
  CONFIRMED
  DELETED
}

enum DraftSource {
  MANUAL
  AI_TEXT
  AI_VOICE
  AI_RECEIPT
  PDF
  OFX
  CSV
  OPEN_FINANCE
}

enum CategoryType {
  INCOME
  EXPENSE
  BOTH
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
}

enum ReportType {
  DRE
  CASH_FLOW
  PATRIMONY
}

enum ReportStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum StatementSource {
  OFX
  CSV
  MANUAL
}

enum StatementItemStatus {
  PENDING
  MATCHED
  REJECTED
  IGNORED
  CONVERTED
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Family {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members      User[]
  invites      FamilyInvite[]
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  transfers    Transfer[]
  creditCards  CreditCard[]
  goals        Goal[]
  budgets      Budget[]
  reports      Report[]
  integrationClients IntegrationClient[]
  reconciliationSessions ReconciliationSession[]
  statementItems         StatementItem[]

  @@map("families")
}

model User {
  id            String   @id @default(uuid())
  familyId      String   @map("family_id")
  name          String
  email         String   @unique
  passwordHash  String?  @map("password_hash")
  keycloakSub   String?  @unique @map("keycloak_sub")
  role          Role     @default(MEMBER)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  family       Family        @relation(fields: [familyId], references: [id])
  transactions Transaction[]
  invitesSent  FamilyInvite[] @relation("InvitedBy")
  integrationClientsCreated IntegrationClient[]
  reconciliationSessions ReconciliationSession[]

  @@map("users")
}

model FamilyInvite {
  id          String    @id @default(uuid())
  familyId    String    @map("family_id")
  invitedById String    @map("invited_by_id")
  email       String
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  family      Family @relation(fields: [familyId], references: [id])
  invitedBy   User   @relation("InvitedBy", fields: [invitedById], references: [id])

  @@map("family_invites")
}

model Account {
  id           String      @id @default(uuid())
  familyId     String      @map("family_id")
  name         String
  type         AccountType
  initialBalance Decimal   @default(0) @map("initial_balance") @db.Decimal(15, 2)
  color        String?
  icon         String?
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  family       Family        @relation(fields: [familyId], references: [id])
  transactions Transaction[]
  transfersFrom Transfer[]   @relation("FromAccount")
  transfersTo   Transfer[]   @relation("ToAccount")
  goals         Goal[]
  creditCardPayments         CreditCardInvoice[]
  reconciliationSessions     ReconciliationSession[]
  statementItems             StatementItem[]

  @@map("accounts")
}

model Category {
  id        String       @id @default(uuid())
  familyId  String       @map("family_id")
  parentId  String?      @map("parent_id")
  name      String
  type      CategoryType
  icon      String?
  color     String?
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  family       Family       @relation(fields: [familyId], references: [id])
  parent       Category?    @relation("SubCategories", fields: [parentId], references: [id])
  subcategories Category[]  @relation("SubCategories")
  transactions Transaction[]
  budgets      Budget[]

  @@map("categories")
}

model Transaction {
  id           String            @id @default(uuid())
  familyId     String            @map("family_id")
  accountId    String            @map("account_id")
  categoryId   String?           @map("category_id")
  createdById  String            @map("created_by_id")
  type         TransactionType
  status       TransactionStatus @default(DRAFT)
  amount       Decimal           @db.Decimal(15, 2)
  description  String
  notes        String?
  date         DateTime          @db.Date
  source       DraftSource       @default(MANUAL)
  transferId   String?           @map("transfer_id")
  creditCardId String?           @map("credit_card_id")
  isRecurring         Boolean           @default(false) @map("is_recurring")
  rrule               String?
  recurringTemplateId String?           @map("recurring_template_id")
  installmentGroupId  String?           @map("installment_group_id")
  installmentIndex    Int?              @map("installment_index")
  installmentCount    Int?              @map("installment_count")
  confirmedAt         DateTime?         @map("confirmed_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  family     Family      @relation(fields: [familyId], references: [id])
  account    Account     @relation(fields: [accountId], references: [id])
  category   Category?   @relation(fields: [categoryId], references: [id])
  createdBy  User        @relation(fields: [createdById], references: [id])
  transfer   Transfer?   @relation(fields: [transferId], references: [id])
  creditCard CreditCard? @relation(fields: [creditCardId], references: [id])
  draft      TransactionDraft?
  statementItems StatementItem[]

  @@map("transactions")
}

model TransactionDraft {
  id            String   @id @default(uuid())
  transactionId String   @unique @map("transaction_id")
  rawInput      String?  @map("raw_input")
  aiResponse    Json?    @map("ai_response")
  createdAt     DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@map("transaction_drafts")
}

model Transfer {
  id          String   @id @default(uuid())
  familyId    String   @map("family_id")
  fromAccountId String @map("from_account_id")
  toAccountId   String @map("to_account_id")
  amount        Decimal @db.Decimal(15, 2)
  description   String?
  date          DateTime @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  family      Family    @relation(fields: [familyId], references: [id])
  fromAccount Account   @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount   Account   @relation("ToAccount", fields: [toAccountId], references: [id])
  transactions Transaction[]

  @@map("transfers")
}

model CreditCard {
  id             String   @id @default(uuid())
  familyId       String   @map("family_id")
  name           String
  limit          Decimal  @db.Decimal(15, 2)
  closingDay     Int      @map("closing_day")
  dueDay         Int      @map("due_day")
  color          String?
  icon           String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  family       Family             @relation(fields: [familyId], references: [id])
  transactions Transaction[]
  invoices     CreditCardInvoice[]

  @@map("credit_cards")
}

model CreditCardInvoice {
  id           String        @id @default(uuid())
  creditCardId String        @map("credit_card_id")
  referenceMonth Int         @map("reference_month")
  referenceYear  Int         @map("reference_year")
  totalAmount    Decimal     @default(0) @map("total_amount") @db.Decimal(15, 2)
  status         InvoiceStatus @default(OPEN)
  paidAt         DateTime?   @map("paid_at")
  paidFromAccountId String?  @map("paid_from_account_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  creditCard      CreditCard @relation(fields: [creditCardId], references: [id])
  paidFromAccount Account?   @relation(fields: [paidFromAccountId], references: [id])

  @@unique([creditCardId, referenceMonth, referenceYear])
  @@index([status])
  @@map("credit_card_invoices")
}

model Goal {
  id          String    @id @default(uuid())
  familyId    String    @map("family_id")
  accountId   String?   @map("account_id")
  name        String
  targetAmount Decimal  @map("target_amount") @db.Decimal(15, 2)
  currentAmount Decimal @default(0) @map("current_amount") @db.Decimal(15, 2)
  deadline    DateTime? @db.Date
  icon        String?
  color       String?
  isCompleted Boolean   @default(false) @map("is_completed")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  family  Family   @relation(fields: [familyId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  @@map("goals")
}

model Budget {
  id             String   @id @default(uuid())
  familyId       String   @map("family_id")
  categoryId     String   @map("category_id")
  referenceMonth Int      @map("reference_month")
  referenceYear  Int      @map("reference_year")
  limitAmount    Decimal  @map("limit_amount") @db.Decimal(15, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  family   Family   @relation(fields: [familyId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([familyId, categoryId, referenceMonth, referenceYear])
  @@map("budgets")
}

model Report {
  id         String       @id @default(uuid())
  familyId   String       @map("family_id")
  type       ReportType
  status     ReportStatus @default(PENDING)
  params     Json
  fileUrl    String?      @map("file_url")
  errorMsg   String?      @map("error_msg")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  family Family @relation(fields: [familyId], references: [id])

  @@map("reports")
}

model IntegrationClient {
  id               String            @id @default(uuid())
  familyId         String            @map("family_id")
  createdById      String            @map("created_by_id")
  name             String
  description      String?
  keycloakClientId String            @unique @map("keycloak_client_id")
  role             Role              @default(MEMBER)
  status           IntegrationStatus @default(ACTIVE)
  lastUsedAt       DateTime?         @map("last_used_at")
  revokedAt        DateTime?         @map("revoked_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  family    Family @relation(fields: [familyId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([familyId, status])
  @@map("integration_clients")
}

model ReconciliationSession {
  id          String          @id @default(uuid())
  familyId    String          @map("family_id")
  accountId   String          @map("account_id")
  source      StatementSource
  fileName    String?         @map("file_name")
  startDate   DateTime?       @db.Date @map("start_date")
  endDate     DateTime?       @db.Date @map("end_date")
  createdById String          @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  family    Family        @relation(fields: [familyId], references: [id])
  account   Account       @relation(fields: [accountId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  items     StatementItem[]

  @@map("reconciliation_sessions")
}

model StatementItem {
  id                   String              @id @default(uuid())
  familyId             String              @map("family_id")
  accountId            String              @map("account_id")
  sessionId            String?             @map("session_id")
  type                 TransactionType
  amount               Decimal             @db.Decimal(15, 2)
  description          String
  date                 DateTime            @db.Date
  externalId           String?             @map("external_id") @db.VarChar(255)
  status               StatementItemStatus @default(PENDING)
  matchedTransactionId String?             @map("matched_transaction_id")
  matchScore           Int?                @map("match_score")
  ignoredAt            DateTime?           @map("ignored_at")
  convertedAt          DateTime?           @map("converted_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  family             Family                 @relation(fields: [familyId], references: [id])
  account            Account                @relation(fields: [accountId], references: [id])
  session            ReconciliationSession? @relation(fields: [sessionId], references: [id])
  matchedTransaction Transaction?           @relation(fields: [matchedTransactionId], references: [id])

  @@unique([accountId, externalId])
  @@index([familyId, accountId, date])
  @@index([familyId, status])
  @@map("statement_items")
}
