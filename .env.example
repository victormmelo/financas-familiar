# Database
POSTGRES_USER=financas
POSTGRES_PASSWORD=financas_password
POSTGRES_DB=financas_familiar
POSTGRES_PORT=5432
DATABASE_URL=postgresql://financas:financas_password@localhost:5432/financas_familiar

# Redis
REDIS_PASSWORD=redis_password
REDIS_PORT=6379
REDIS_URL=redis://:redis_password@localhost:6379

# Keycloak (docker-compose serviço keycloak — host network :8080)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=financas-familiar
KEYCLOAK_WEB_CLIENT_ID=financas-web
KEYCLOAK_MCP_CLIENT_ID=financas-mcp
KEYCLOAK_MCP_CLIENT_SECRET=change_me_mcp_secret
KEYCLOAK_IDENTITY_ADMIN_CLIENT_ID=financas-identity-admin
KEYCLOAK_IDENTITY_ADMIN_CLIENT_SECRET=change_me_identity_admin_secret

# API — validação JWT do Keycloak (resource server)
# Issuer = realm URL, ex.: http://localhost:8080/realms/financas-familiar
KEYCLOAK_ISSUER=http://localhost:8080/realms/financas-familiar
# Client ID do client OIDC no Keycloak (ex.: financas-web)
KEYCLOAK_AUDIENCE=financas-web
# Opcional — se vazio, a API obtém via /.well-known/openid-configuration
# KEYCLOAK_JWKS_URI=http://localhost:8080/realms/financas-familiar/protocol/openid-connect/certs

# MinIO / Storage
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_PORT=9000
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minio_admin
STORAGE_SECRET_KEY=minio_password
STORAGE_BUCKET=financas-familiar
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://localhost:9000/financas-familiar

# AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Open Finance
OPEN_FINANCE_PROVIDER=pluggy
OPEN_FINANCE_CLIENT_ID=your_open_finance_client_id
OPEN_FINANCE_CLIENT_SECRET=your_open_finance_client_secret
OPEN_FINANCE_WEBHOOK_SECRET=your_open_finance_webhook_secret

# Email / SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@financas-familiar.local

# App
NODE_ENV=development
PORT=3001
# Base da app (links em e-mails da API, ex.: convite)
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Família Finance
COOKIE_SECRET=change_me_cookie_secret_32chars_min_ok_dev

# Next.js Auth.js v5 + Keycloak
# Gere AUTH_SECRET com: openssl rand -base64 32
AUTH_SECRET=change_me_auth_secret_generate_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3000/api/auth
NEXTAUTH_URL=http://localhost:3000/api/auth
NEXTAUTH_URL_INTERNAL=http://localhost:3000/api/auth
AUTH_TRUST_HOST=true
AUTH_KEYCLOAK_ID=financas-web
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/financas-familiar
# Logout OIDC (opcional — melhora UX no logout)
AUTH_KEYCLOAK_END_SESSION_URL=http://localhost:8080/realms/financas-familiar/protocol/openid-connect/logout

# MCP
MCP_PORT=3002
MCP_PUBLIC_URL=http://localhost:3002/mcp

# Monitoramento (opcional em dev)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=  # necessário apenas para upload de source maps em produção
CORS_ORIGIN=http://localhost:3000
