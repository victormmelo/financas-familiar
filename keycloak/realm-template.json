{
  "realm": "__KEYCLOAK_REALM__",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "verifyEmail": true,
  "sslRequired": "external",
  "clientScopes": [
    {
      "name": "mcp-resource-audience",
      "description": "Audience do recurso MCP (RFC 8707 / ChatGPT). Inclui o claim aud no access token.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "mcp-resource-aud-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "aud",
            "claim.value": "__MCP_RESOURCE_IDENTIFIER__",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "__KEYCLOAK_WEB_CLIENT_ID__",
      "name": "Financas Familiar Web",
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "__APP_URL__/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "__APP_URL__"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "__APP_URL__/*"
      },
      "defaultClientScopes": ["web-origins", "profile", "email", "roles"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "__KEYCLOAK_MCP_CLIENT_ID__",
      "name": "Financas Familiar MCP",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__KEYCLOAK_MCP_CLIENT_SECRET__",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "__MCP_PUBLIC_URL__/*"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["web-origins", "profile", "email", "roles", "mcp-resource-audience"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "__KEYCLOAK_IDENTITY_ADMIN_CLIENT_ID__",
      "name": "Financas Familiar Identity Admin",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__KEYCLOAK_IDENTITY_ADMIN_CLIENT_SECRET__",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ]
}
